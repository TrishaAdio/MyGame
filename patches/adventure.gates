# Frame-counted logic in the adventure build (a8, 240x320).
# Found with ProbePatcher + RmwFinder + TracePatcher, reviewed by hand.
# Formats: see platformer.gates

# Game frame counter (cycling effects)
g c ()Z g.ak 0 scale
# Dialog typewriter: one more character every frame
g a (Ljavax/microedition/lcdui/Graphics;Ljava/lang/String;IIIIIIII)Z g.as 0 scale
# Map view panning: 8 px every frame while a direction is held
g aq ()V g.aE 3 scale
g aq ()V g.aF 3 scale
# Paint frame counter
i a (Ljavax/microedition/lcdui/Graphics;)V i.aU 0 scale

# Physics: this build's movement code also counts frames (walk start, ground checks, air states).
# Smooth mode is NOT enabled for this build yet; it runs at the original 16 FPS game speed.
